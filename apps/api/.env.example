# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gatepass

# Redis Connection
# Format: redis://host:port
REDIS_URL=redis://localhost:6379

# JWT Secrets (Must be secure, random strings)
JWT_ACCESS_SECRET=your_jwt_access_secret_should_be_long_and_secure
JWT_REFRESH_SECRET=your_jwt_refresh_secret_should_be_long_and_secure

# Stripe Configuration
# Obtain these from your Stripe Dashboard (Developers section)
STRIPE_SECRET_KEY=sk_test_mock_stripe_key_for_testing
STRIPE_WEBHOOK_SECRET=whsec_mock_webhook_secret_for_testing

# HMAC Security Secret
# Key used to generate secure signatures for QR ticket verification
HMAC_QR_SECRET=your_hmac_qr_signature_secret_key

# Email Delivery Configuration
# To use Resend, set RESEND_API_KEY and EMAIL_FROM
RESEND_API_KEY=re_mock_resend_api_key_for_testing
EMAIL_FROM=tickets@gatepass.com

# SMTP Fallback (Nodemailer config if RESEND_API_KEY is not set)
# Useful for mailtrap or local testing
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mock_smtp_user
SMTP_PASS=mock_smtp_password
